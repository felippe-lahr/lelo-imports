# Lelo Imports — configuração Apache (Hostinger)

# Página inicial padrão
DirectoryIndex index.html

# Tipo MIME para WebP (fotos das categorias)
<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

# Compressão (o HTML tem assets embutidos em base64 — comprimir reduz muito o tráfego)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache do navegador
<IfModule mod_expires.c>
  ExpiresActive On
  # index.html revalida sempre (para publicar atualizações imediatamente)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Segurança básica
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
